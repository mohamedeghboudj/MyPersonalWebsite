---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { snapshotSchema, type Locale } from '@platform/schema';
import { resolveTranslation } from '@platform/database';

export function getStaticPaths() {
  return [{ params: { locale: undefined }, props: { language: 'en' } }, { params: { locale: 'fr' }, props: { language: 'fr' } }, { params: { locale: 'ar' }, props: { language: 'ar' } }];
}
const locale = Astro.props.language as Locale;
// Generated by the local spike or retrieved from the authenticated snapshot API.
// A missing snapshot is a build error, never a fallback to hardcoded biography.
const snapshot = snapshotSchema.parse(JSON.parse(await readFile(resolve('../../artifacts/snapshot.json'), 'utf8')));
const headline = resolveTranslation(snapshot.profile.translations, locale);
const summary = resolveTranslation(snapshot.publicVariant.translations, locale);
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={headline.headline} />
    <title>{snapshot.profile.fullName}</title>
  </head>
  <body>
    <main data-revision={snapshot.revision}>
      <h1>{snapshot.profile.fullName}</h1>
      <p lang={headline.locale} dir={headline.locale === 'ar' ? 'rtl' : 'ltr'}>{headline.headline}</p>
      <p lang={summary.locale} dir={summary.locale === 'ar' ? 'rtl' : 'ltr'}>{summary.summary}</p>
      {snapshot.education.map((item) => {
        const translated = resolveTranslation(item.translations, locale);
        return <article lang={translated.locale} dir={translated.locale === 'ar' ? 'rtl' : 'ltr'} data-content-id={item.id}>
          <h2>{translated.school}</h2>
          <p>{translated.degree}</p>
          <p><time datetime={item.startDate}>{item.startDate}</time>{item.endDate && <> — <time datetime={item.endDate}>{item.endDate}</time></>}</p>
          <p>{translated.description}</p>
        </article>;
      })}
    </main>
  </body>
</html>
