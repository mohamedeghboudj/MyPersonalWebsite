{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mohamedeghboudj-admin-spike-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CONTENT",
      "database_name": "content-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../database/migrations/content"
    },
    {
      "binding": "INBOX",
      "database_name": "inbox-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../database/migrations/inbox"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "media-local" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
