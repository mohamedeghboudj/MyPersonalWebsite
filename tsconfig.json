{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "@platform/schema": ["./packages/schema/src/index.ts"],
      "@platform/config": ["./packages/config/src/index.ts"],
      "@platform/database": ["./database/src/index.ts"],
      "@platform/cv-engine": ["./packages/cv-engine/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "database/**/*.ts",
    "apps/admin/**/*.ts",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".tools", ".cache"]
}
